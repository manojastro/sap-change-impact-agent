# --- SAP Change Impact & Regression Risk Agent : environment template ---
# Copy to .env and adjust. All values have safe defaults for the simulation.

APP_NAME="SAP Change Impact & Regression Risk Agent"
ENVIRONMENT=simulation

# SQLite by default. For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg://sap:sap@localhost:5432/sap_change_impact
DATABASE_URL=sqlite:///./data/sap_change_impact.db

# LLM: mock (deterministic, facts-only, no network) or openai (any
# OpenAI-compatible endpoint). The platform is fully functional in mock mode.
LLM_MODE=mock
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=change-me
LLM_MODEL=deterministic-mock

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:8013,http://127.0.0.1:8013

LOG_LEVEL=INFO
